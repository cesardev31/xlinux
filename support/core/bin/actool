#!/usr/bin/env python3
"""actool stand-in: compiles asset catalogs (.xcassets) without Xcode.

Apple's actool produces Assets.car (CoreUI's private binary format). Here each
imageset is written as loose PNGs (`name@2x.png`, `name@3x.png`,
`name@2x~ipad.png`) into the output directory. UIKit still finds them:
`UIImage(named:in:compatibleWith:)` looks in the compiled catalog first and
then in the bundle's files.

- PNG/JPG: copied with their scale.
- Vector PDF/SVG: rasterized to @2x and @3x (pdftocairo / cairosvg).
- AppIcon (--app-icon): icons + CFBundleIcons in the partial Info.plist.
- colorset/dataset/symbolset: no equivalent without Assets.car → warning.
- "template-rendering-intent" is lost (the icon isn't tinted automatically).

Implements the interface used by Xcode / Swift Build (AssetCatalogCompiler.xcspec).
"""

import json
import os
import plistlib
import shutil
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[3]))
from xlinux.core import config, deps  # noqa: E402

# cairosvg lives in the data directory's venv: re-exec with that Python.
try:
    import cairosvg
except ImportError:
    venv_python = config.data_dir() / "py-tools/bin/python"
    if venv_python.exists() and sys.executable != str(venv_python) and not os.environ.get("XLINUX_ACTOOL_REEXEC"):
        os.environ["XLINUX_ACTOOL_REEXEC"] = "1"
        os.execv(str(venv_python), [str(venv_python), __file__, *sys.argv[1:]])
    cairosvg = None

VERSION_PLIST = {"com.apple.actool.version": {"bundle-version": "24000", "short-bundle-version": "27.0"}}
VECTOR_SCALES = (2, 3)


def put(src, dst):
    """Copy contents only: SwiftPM checkouts are read-only, and copying their
    permissions would prevent overwriting the output on the next build."""
    if dst.exists():
        dst.unlink()
    shutil.copyfile(src, dst)


def warn(msg):
    print(f"warning: {msg}", flush=True)


def parse(argv):
    opts = {"inputs": [], "app_icon": None, "compile": None, "dependency_info": None,
            "partial_plist": None, "generated": [], "output_format": "human-readable-text"}
    value_opts = {"--compile": "compile", "--export-dependency-info": "dependency_info",
                  "--output-partial-info-plist": "partial_plist", "--app-icon": "app_icon",
                  "--output-format": "output_format"}
    it = iter(argv)
    for arg in it:
        if arg in value_opts:
            opts[value_opts[arg]] = next(it)
        elif arg.startswith("--generate-") and arg.endswith(("-symbols", "-path", "-index")):
            opts["generated"].append((arg, next(it)))
        elif arg.startswith("--"):
            # Options with a value that don't affect the output here.
            if arg in ("--enable-on-demand-resources", "--development-region", "--target-device",
                       "--minimum-deployment-target", "--platform", "--filter-for-device-model",
                       "--filter-for-device-os-version", "--sticker-pack-identifier-prefix",
                       "--product-type", "--bundle-identifier", "--accent-color",
                       "--widget-background-color", "--include-all-app-icons",
                       "--alternate-app-icon", "--launch-image", "--compile-dependency-info",
                       "--generate-swift-asset-symbol-extensions"):
                next(it, None)
        else:
            opts["inputs"].append(arg)
    return opts


def svg_size(path):
    import re
    text = Path(path).read_text(errors="replace")
    head = text[:4000]

    def attr(name):
        m = re.search(rf'\b{name}="([\d.]+)(px)?"', head)
        return float(m.group(1)) if m else None

    w, h = attr("width"), attr("height")
    if w and h:
        return w, h
    m = re.search(r'viewBox="[\d.\-]+[ ,]+[\d.\-]+[ ,]+([\d.]+)[ ,]+([\d.]+)"', head)
    return (float(m.group(1)), float(m.group(2))) if m else (None, None)


def render_vector(src, dst, scale):
    if dst.exists():
        dst.unlink()
    if src.suffix.lower() == ".pdf":
        prefix = str(dst.with_suffix(""))
        subprocess.run(["pdftocairo", "-png", "-singlefile", "-transp", "-r", str(72 * scale), str(src), prefix],
                       check=True, capture_output=True)
        return True
    if src.suffix.lower() == ".svg":
        if cairosvg is None:
            if os.environ.get("XLINUX_ACTOOL_REEXEC"):
                warn(f"cannot rasterize {src.name} without cairosvg")
                return False
            # First SVG ever: install cairosvg and start over with its Python.
            python = deps.ensure_cairosvg()
            os.environ["XLINUX_ACTOOL_REEXEC"] = "1"
            os.execv(str(python), [str(python), __file__, *sys.argv[1:]])
        cairosvg.svg2png(url=str(src), write_to=str(dst), scale=scale)
        return True
    return False


def compile_imageset(imageset, name, out, outputs):
    contents = json.loads((imageset / "Contents.json").read_text())
    for image in contents.get("images", []):
        filename = image.get("filename")
        if not filename:
            continue
        src = imageset / filename
        if not src.exists():
            continue
        idiom = image.get("idiom", "universal")
        suffix = "~ipad" if idiom == "ipad" else ""
        if idiom not in ("universal", "iphone", "ipad"):
            continue
        scale = image.get("scale")
        ext = src.suffix.lower()
        if ext in (".pdf", ".svg"):
            scales = [int(scale[0])] if scale else VECTOR_SCALES
            for s in scales:
                dst = out / f"{name}{'' if s == 1 else f'@{s}x'}{suffix}.png"
                try:
                    if render_vector(src, dst, s):
                        outputs.append(dst)
                except Exception as e:  # one odd SVG must not break the whole catalog
                    warn(f"could not rasterize {imageset.name}/{filename}: {e}")
                    break
        elif ext in (".png", ".jpg", ".jpeg"):
            s = scale or "1x"
            dst = out / f"{name}{'' if s == '1x' else '@' + s}{suffix}{'.png' if ext == '.png' else ext}"
            put(src, dst)
            outputs.append(dst)


# Xcode 14+ "single size" app icons: one 1024 px image, from which Xcode
# generates every size. Without Assets.car, the loose PNGs iOS looks up by name.
SINGLE_SIZE_ICONS = {
    "iphone": [("29x29", 2), ("29x29", 3), ("40x40", 2), ("40x40", 3), ("60x60", 2), ("60x60", 3)],
    "ipad": [("29x29", 1), ("29x29", 2), ("40x40", 1), ("40x40", 2), ("76x76", 1), ("76x76", 2),
             ("83.5x83.5", 2)],
}


def resize_png(src, dst, pixels):
    """Resize with Pillow (a dependency of cairosvg, in the data directory's venv)."""
    code = ("import sys; from PIL import Image; "
            "Image.open(sys.argv[1]).resize((int(sys.argv[3]),) * 2, Image.LANCZOS).save(sys.argv[2])")
    try:
        import PIL  # noqa: F401
        python = sys.executable
    except ImportError:
        python = str(deps.ensure_cairosvg())
    subprocess.run([python, "-c", code, str(src), str(dst), str(pixels)], check=True)


def single_size_app_icon(iconset, image, out, outputs):
    src = iconset / image["filename"]
    icons = {}
    for idiom, sizes in SINGLE_SIZE_ICONS.items():
        names = []
        for size, scale in sizes:
            points = float(size.split("x")[0])
            dst = out / f"AppIcon{size}{'' if scale == 1 else f'@{scale}x'}{'~ipad' if idiom == 'ipad' else ''}.png"
            resize_png(src, dst, round(points * scale))
            outputs.append(dst)
            if f"AppIcon{size}" not in names:
                names.append(f"AppIcon{size}")
        icons[idiom] = {"CFBundlePrimaryIcon": {"CFBundleIconFiles": names}}
    return {"CFBundleIcons": icons["iphone"], "CFBundleIcons~ipad": icons["ipad"]}


def compile_app_icon(iconset, out, outputs):
    contents = json.loads((iconset / "Contents.json").read_text())
    names = set()
    for image in contents.get("images", []):
        filename, size = image.get("filename"), image.get("size", "")
        if not filename or image.get("idiom") not in ("iphone", "ipad", "universal") or size == "1024x1024":
            continue
        base = f"AppIcon{size}"
        scale = image.get("scale", "1x")
        dst = out / f"{base}{'' if scale == '1x' else '@' + scale}{'~ipad' if image['idiom'] == 'ipad' else ''}.png"
        put(iconset / filename, dst)
        outputs.append(dst)
        names.add(base)
    if not names:
        single = [image for image in contents.get("images", [])
                  if image.get("filename") and image.get("size") == "1024x1024"
                  and image.get("idiom") == "universal" and not image.get("appearances")]
        return single_size_app_icon(iconset, single[0], out, outputs) if single else {}
    icons = {"CFBundlePrimaryIcon": {"CFBundleIconFiles": sorted(names)}}
    return {"CFBundleIcons": icons, "CFBundleIcons~ipad": icons}


def walk(folder, prefix, opts, out, outputs, partial):
    for entry in sorted(folder.iterdir()):
        if not entry.is_dir():
            continue
        name = entry.stem
        if entry.suffix == ".imageset":
            compile_imageset(entry, prefix + name, out, outputs)
        elif entry.suffix == ".appiconset":
            if name == opts["app_icon"]:
                partial.update(compile_app_icon(entry, out, outputs))
        elif entry.suffix in (".colorset", ".dataset", ".symbolset", ".imagestack", ".brandassets",
                              ".launchimage", ".textureset", ".cubetextureset"):
            warn(f"{entry.name}: {entry.suffix[1:]} is not supported without Assets.car; skipping")
        elif not entry.suffix:
            contents = entry / "Contents.json"
            namespace = contents.exists() and json.loads(contents.read_text()).get(
                "properties", {}).get("provides-namespace")
            walk(entry, prefix + (name + "/" if namespace else ""), opts, out, outputs, partial)


def write_dependency_info(path, inputs, outputs):
    # Xcode's format (the same as `ld -dependency_info`): records
    # <opcode><string>\0 — 0x00 version, 0x10 input, 0x40 output.
    data = b"\x00actool-27.0\x00"
    data += b"".join(b"\x10" + str(p).encode() + b"\x00" for p in inputs)
    data += b"".join(b"\x40" + str(p).encode() + b"\x00" for p in outputs)
    Path(path).write_bytes(data)


def main(argv):
    if "--version" in argv:
        sys.stdout.buffer.write(plistlib.dumps(VERSION_PLIST))
        return 0
    opts = parse(argv)
    if not opts["compile"]:
        print("error: actool (xlinux) only supports --compile", file=sys.stderr)
        return 1
    out = Path(opts["compile"])
    out.mkdir(parents=True, exist_ok=True)
    outputs, partial, inputs = [], {}, []
    for catalog in opts["inputs"]:
        catalog = Path(catalog)
        inputs.append(catalog)
        walk(catalog, "", opts, out, outputs, partial)
    if opts["partial_plist"]:
        Path(opts["partial_plist"]).write_bytes(plistlib.dumps(partial))
    if opts["dependency_info"]:
        write_dependency_info(opts["dependency_info"], inputs, outputs)
    for flag, path in opts["generated"]:
        # Asset symbols (ImageResource/ColorResource, Xcode 15+): empty.
        Path(path).parent.mkdir(parents=True, exist_ok=True)
        Path(path).write_text("" if not path.endswith(".swift") else "import Foundation\n")
    if opts["output_format"] == "xml1":
        sys.stdout.buffer.write(plistlib.dumps({"com.apple.actool.compilation-results":
                                                {"output-files": [str(p) for p in outputs]}}))
    return 0


sys.exit(main(sys.argv[1:]))
